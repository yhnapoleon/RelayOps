# Optional. Without these, core workflows and synthetic monitoring still work.
RELAYOPS_LLM_ENDPOINT=
RELAYOPS_LLM_API_KEY=
RELAYOPS_LLM_MODEL=
# Set a random 32+ byte signing secret for any deployment beyond local demos.
RELAYOPS_JWT_SECRET=
# Disable demo initialization before starting a new non-demo database.
# This setting does not delete accounts that already exist.
RELAYOPS_DEMO_ACCOUNTS=true
# Initial administrator password: 12+ characters. Existing passwords are
# never reset by these bootstrap settings.
RELAYOPS_ADMIN_USERNAME=admin
RELAYOPS_ADMIN_PASSWORD=
